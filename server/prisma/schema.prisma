generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  name          String
  username      String  @unique
  password      String
  plainPassword String?
  role          String
  fieldId       String?
  unitId        String?
  isDeleted     Boolean @default(false)

  @@map("users")
}

model Account {
  id          String   @id @default(uuid())
  code        String
  name        String
  category    String?
  type        String?
  subType     String?
  fund        String?
  balance     Decimal? @default(0) @db.Decimal(15, 2)
  isParent    Boolean  @default(false)
  parentId    String?
  level       Int      @default(0)
  orderIdx    Int      @default(0)
  isDeleted   Boolean  @default(false)

  @@map("accounts")
}

model Journal {
  id              String   @id @default(uuid())
  date            DateTime?
  name            String?
  description     String?  @db.Text
  entries         Json?
  receiptPath     String?
  assetGenerated  Boolean  @default(false) @map("_assetGenerated")
  isDeleted       Boolean  @default(false)
  programId       String?
  reference       String?
  proof           String?  @db.Text
  phoneNumber     String?

  @@map("journals")
}

model Asset {
  id                   String    @id @default(uuid())
  code                 String?
  name                 String
  brand                String?
  vendor               String?
  category             String?
  description          String?   @db.Text
  acquisitionDate      DateTime?
  acquisitionStatus    String?   @default("Beli Baru")
  cost                 Decimal?  @db.Decimal(15, 2)
  usefulLifeMonths     Int?
  residualValue        Decimal?  @db.Decimal(15, 2)
  pic                  String?
  fundSource           String?   @default("Yayasan")
  condition            String?   @default("BAIK")
  status               String?   @default("Tersedia")
  unitId               String?
  assetRoom            String?
  isDeleted            Boolean   @default(false)

  @@map("assets")
}

model Program {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  category     String?
  targetAmount           Decimal? @default(0) @db.Decimal(15, 2)
  status                 String?  @default("Aktif")
  initialDonationBalance Decimal? @default(0) @db.Decimal(15, 2)
  initialResultBalance   Decimal? @default(0) @db.Decimal(15, 2)
  startDate              DateTime?
  endDate                DateTime?
  unitId       String?
  fieldId      String?
  type         String?  @default("Donation") // Donation, Expense
  isDeleted    Boolean  @default(false)

  @@map("programs")
}

model ExpenseProgram {
  id              String   @id @default(uuid())
  name            String
  description     String?  @db.Text
  unitId          String?
  fieldId         String?
  type            String?  @default("Expense")
  debitAccountId  String?
  creditAccountId String?
  isDeleted       Boolean  @default(false)

  @@map("expense_programs")
}
model Budget {
  id        String   @id @default(uuid())
  accountId String
  year      String
  amount    Decimal  @default(0) @db.Decimal(15, 2)
  isDeleted Boolean  @default(false)

  @@map("budgets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  details   Json?

  @@map("audit_logs")
}

// --- NEW MODELS FOR ANGGARAN & PELAPORAN ---

model Field {
  id        String   @id @default(uuid())
  name      String   @unique
  isDeleted Boolean  @default(false)
  
  units        Unit[]
  expenseItems ExpenseItem[]

  @@map("fields")
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id])
  receivesBos Boolean  @default(false)
  isDeleted Boolean  @default(false)

  students       Student[]
  expenseItems   ExpenseItem[]
  classes        Class[]
  bosAllocations BosAllocation[]

  @@map("units")
  @@unique([fieldId, name])
}

model Student {
  id              String         @id @default(uuid())
  name            String
  nis             String?
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id])
  classId         String?
  class           Class?         @relation(fields: [classId], references: [id])
  academicYearId  String?
  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id])
  statusId        String?
  status          StudentStatus? @relation(fields: [statusId], references: [id])
  parentStatusId  String?
  parentStatus    ParentStatus?  @relation(fields: [parentStatusId], references: [id])
  gender          String?
  isDeleted       Boolean        @default(false)

  incomeDetails StudentIncomeDetail[]

  @@map("Student")
}

model Class {
  id          String      @id @default(uuid())
  name        String      // e.g., 7-A, 10-IPA-1
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  isDeleted   Boolean     @default(false)

  students    Student[]

  @@map("Class")
  @@unique([unitId, name])
}

model IncomeItem {
  id        String   @id @default(uuid())
  name      String   @unique
  isBos     Boolean  @default(false)
  isDeleted Boolean  @default(false)

  studentDetails       StudentIncomeDetail[]
  distributionSettings DistributionSetting[]

  @@map("income_items")
}

model ExpenseItem {
  id              String   @id @default(uuid())
  name            String
  unitId          String?
  unit            Unit?    @relation(fields: [unitId], references: [id])
  fieldId         String?
  field           Field?   @relation(fields: [fieldId], references: [id])
  accountId       String?
  debitAccountId  String?
  creditAccountId String?
  sourceOfFunds   String?
  isBos           Boolean  @default(false)
  isDeleted       Boolean  @default(false)

  allocations          BudgetAllocation[]
  distributionSettings DistributionSetting[]
  requests             BudgetRequest[]
  reports              BudgetReport[]

  @@map("expense_items")
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., 2023/2024
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)

  students             Student[]
  bosStages            BosStage[]
  bosAllocations       BosAllocation[]
  distributionSettings DistributionSetting[]

  @@map("AcademicYear")
}

model BosStage {
  id             String        @id @default(uuid())
  name           String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  isDeleted      Boolean       @default(false)
  
  bosAllocations BosAllocation[]

  @@map("bos_stages")
}

model BosPos {
  id        String   @id @default(uuid())
  name      String   @unique
  isDeleted Boolean  @default(false)

  bosAllocations BosAllocation[]

  @@map("bos_pos")
}

model ClassGroup {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., Reguler, Tahfizh
  isDeleted Boolean  @default(false)

  @@map("class_groups")
}

model Position {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., Kepala Sekolah, Bendahara
  isDeleted Boolean  @default(false)

  @@map("positions")
}

model StudentStatus {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., Aktif, Alumni
  isDeleted Boolean  @default(false)

  students  Student[]

  @@map("StudentStatus")
}

model ParentStatus {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., Mampu, Tidak Mampu
  isDeleted Boolean  @default(false)

  students  Student[]

  @@map("ParentStatus")
}

model StudentIncomeDetail {
  id           String     @id @default(uuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  incomeItemId String
  incomeItem   IncomeItem @relation(fields: [incomeItemId], references: [id])
  amount       Decimal    @db.Decimal(15, 2)
  isDeleted    Boolean    @default(false)

  @@map("StudentIncomeDetail")
}



model DistributionSetting {
  id             String        @id @default(uuid())
  unitId         String        // The unit receiving the income
  academicYearId String?       // Associated academic year
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  incomeItemId   String
  incomeItem     IncomeItem    @relation(fields: [incomeItemId], references: [id])
  expenseItemId  String
  expenseItem    ExpenseItem   @relation(fields: [expenseItemId], references: [id])
  percentage     Decimal       @db.Decimal(5, 2)
  destType       String?       @default("unit")
  destId         String?
  destName       String?
  isDeleted      Boolean       @default(false)

  @@map("distribution_settings")
}


model BudgetAllocation {
  id            String      @id @default(uuid())
  expenseItemId String
  expenseItem   ExpenseItem @relation(fields: [expenseItemId], references: [id])
  year          String
  amount        Decimal     @db.Decimal(15, 2)
  isDeleted     Boolean     @default(false)

  @@map("budget_allocations")
}

model BudgetRequest {
  id            String      @id @default(uuid())
  expenseItemId String?
  expenseItem   ExpenseItem? @relation(fields: [expenseItemId], references: [id])
  unitId        String?
  fieldId       String?
  academicYearId String?
  amount        Decimal?     @db.Decimal(15, 2)
  totalAmount   Decimal?     @db.Decimal(15, 2)
  items         Json?
  date          DateTime    @default(now())
  month         String?
  year          Int?
  source        String?     @db.VarChar(20)
  description   String?
  status                  String        @default("PENDING") // PENDING, APPROVED, REJECTED
  notified                Boolean       @default(false)
  isDeleted               Boolean       @default(false)
  sourceBankAccountId     String?
  targetUnitBankAccountId String?
  creditAccountId         String?
  transferJournalId       String?

  reports                 BudgetReport[]

  @@map("budget_requests")
}

model BudgetReport {
  id              String        @id @default(uuid())
  budgetRequestId String?
  budgetRequest   BudgetRequest? @relation(fields: [budgetRequestId], references: [id])
  componentId     String?       @db.VarChar(255)
  expenseItemId   String?
  expenseItem     ExpenseItem?   @relation(fields: [expenseItemId], references: [id])
  unitId          String?
  fieldId         String?
  academicYearId  String?
  planId          String?       @db.VarChar(100)
  category        String?
  source          String?       @db.VarChar(20)
  amount          Decimal?       @db.Decimal(15, 2)
  date            DateTime      @default(now())
  description     String?
  journalId       String?
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  notified        Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  // New fields for enhanced laporan form
  buktiTeks       String?       @db.Text
  buktiFoto       String?       @db.LongText
  nomorNota       String?
  volume          Decimal?      @db.Decimal(15, 4)
  satuan          String?
  harga           Decimal?      @db.Decimal(15, 2)
  diskon          Decimal?      @db.Decimal(15, 2)
  kategoriAset    String?       @default("NON_ASET")
  umurEkonomis    Int?
  namaAset        String?

  @@map("budget_reports")
}

model RabPlan {
  id              String   @id // Formatted as academicYearId-unitId or academicYearId-FIELD-fieldId
  academicYearId  String
  unitId          String?
  fieldId         String?
  income          Json?
  expense         Json?
  status          String   @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  rejectionReason String?  @db.Text
  notified        Boolean  @default(false)
  updatedAt       DateTime @default(now()) @updatedAt
  updatedBy       String?

  @@map("rab_plans")
}

model BudgetShift {
  id                String    @id @default(uuid())
  code              String?   // e.g. PGS/2026/001
  academicYearId    String
  type              String    // "UNIT_REQUEST" (Bottom-Up) or "MANAGEMENT_ORDER" (Top-Down)
  transferScope     String    @default("INTERNAL_UNIT") // "INTERNAL_UNIT" or "CROSS_UNIT"
  
  fromUnitId        String?
  fromFieldId       String?
  toUnitId          String?
  toFieldId         String?
  
  fromExpenseItemId String?
  toExpenseItemId   String?
  
  amount            Decimal   @db.Decimal(15, 2)
  
  letterNumber      String?   // Nomor Surat Permohonan / Nomor Memo Yayasan
  letterDate        DateTime? // Tanggal Surat / Memo
  fileProof         String?   @db.LongText // Base64 / LongText
  fileName          String?   // Original File Name
  fileType          String?   // pdf, png, jpg, etc.
  reason            String    @db.Text // Penjelasan & Urgensi
  
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, APPLIED
  requestedBy       String?   // User ID
  requestedByName   String?   // User Name
  approvedBy        String?   // User ID
  approvedByName    String?   // User Name
  approvedAt        DateTime?
  rejectionReason   String?   @db.Text
  
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@map("budget_shifts")
}

model Contact {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   // "Donatur", "Penerima Manfaat", "Lainnya"
  phone     String?
  address   String?  @db.Text
  province  String?
  city      String?
  district  String?
  isDeleted Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  
  @@map("contacts")
}

model BosAllocation {
  id              String      @id @default(uuid())
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  stageId         String
  stage           BosStage    @relation(fields: [stageId], references: [id])
  posId           String
  pos             BosPos      @relation(fields: [posId], references: [id])
  unitId          String
  unit            Unit        @relation(fields: [unitId], references: [id])
  expenseItemId   String?     @db.VarChar(255)
  amount          Decimal     @db.Decimal(15, 2)
  isDeleted       Boolean     @default(false)
  updatedAt       DateTime    @default(now()) @updatedAt

  @@map("bos_allocations")
}

model AssetCategory {
  id           String   @id @default(uuid())
  name         String
  code         String?
  economicLife Int?     @default(4)
  description  String?  @db.Text
  isDeleted    Boolean  @default(false)

  @@map("asset_categories")
}

model AssetVendor {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?  @db.Text
  note      String?  @db.Text
  isDeleted Boolean  @default(false)

  @@map("asset_vendors")
}

model AssetRoom {
  id          String   @id @default(uuid())
  name        String
  unitId      String?
  description String?  @db.Text
  isDeleted   Boolean  @default(false)

  @@map("asset_rooms")
}

model AssetPic {
  id        String   @id @default(uuid())
  name      String
  role      String?
  unitId    String?
  phone     String?
  isDeleted Boolean  @default(false)

  @@map("asset_pics")
}
